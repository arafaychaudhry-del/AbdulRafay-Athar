}



@media (max-width: 480px) {
  .product-grid {
    padding: 20px 12px;
  }


  .product-grid__header {
    margin-bottom: 16px;
  }


  .product-grid__header h2 {
    font-size: 22px;
  }


  .product-grid__wrapper {
    gap: 10px;
  }



  /* Quick View Extra Small - Horizontal */

  .product-quick-view__box {
    min-width: 140px;
    padding: 6px;
    gap: 6px;
  }



  .product-quick-view__image-wrapper {
    width: 50px;
    height: 50px;
  }


  .product-quick-view__content {
    padding-right: 14px;
  }


  .product-quick-view__title {
    font-size: 10px;
  }


  .product-quick-view__price {
    font-size: 10px;
  }


  .product-popup__card {
    max-width: 280px;
  }


  .product-popup__top {
    padding: 10px;
  }


  .product-popup__image-wrapper {
