  }


  .product-popup__options {
    padding: 0 10px;
  }


  .product-popup__footer {
    padding: 8px 10px 10px 10px;
  }
}
</style>




<script>
document.addEventListener('DOMContentLoaded', () => {

  const popup = document.querySelector('.product-popup');
  const popupImg = popup.querySelector('.product-popup__image');
  const title = popup.querySelector('.product-popup__title');
  const price = popup.querySelector('.product-popup__price');
  const desc = popup.querySelector('.product-popup__description');
  const optionsWrap = popup.querySelector('.product-popup__options');
  const addBtn = popup.querySelector('.product-popup__add');

  let currentProduct = null;
  let selectedOptions = {};
  let currentQuickView = null;

  // Open quick view on hotspot click

  document.querySelectorAll('.product-grid__hotspot').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      e.stopPropagation();
      const wrapper = btn.closest('.product-grid__image-wrapper');
      const handle = wrapper.dataset.handle;
      const quickViewBox = wrapper.querySelector('.product-quick-view__box');

      try {
        const res = await fetch(`/products/${handle}.js`);
        currentProduct = await res.json();




        // Set quick view content

        const quickViewImg = quickViewBox.querySelector('.product-quick-view__image');
        const quickViewTitle = quickViewBox.querySelector('.product-quick-view__title');
        const quickViewPrice = quickViewBox.querySelector('.product-quick-view__price');

        quickViewImg.src = currentProduct.images[0];
        quickViewImg.alt = currentProduct.title;
        quickViewTitle.textContent = currentProduct.title;
        
        const priceValue = (currentProduct.price / 100).toFixed(2);
        quickViewPrice.textContent = `${priceValue}€`;




        // Close any other open quick views

        document.querySelectorAll('.product-quick-view__box').forEach(box => {
          if (box !== quickViewBox) {
            box.style.display = 'none';
          }
        });




        // Show quick view

        quickViewBox.style.display = 'flex';
        currentQuickView = quickViewBox;

      } catch (error) {
        console.error('Error loading product:', error);
      }
    });
  });





  // Click quick view box to open full popup

  document.addEventListener('click', (e) => {
    const quickViewBox = e.target.closest('.product-quick-view__box');
    if (quickViewBox && !e.target.closest('.product-quick-view__close')) {
      openFullPopup();
    }
  });




  // Close quick view buttons

  document.querySelectorAll('.product-quick-view__close').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const quickViewBox = btn.closest('.product-quick-view__box');
      quickViewBox.style.display = 'none';
      currentQuickView = null;
    });
  });



  function openFullPopup() {
    if (!currentProduct) return;



    // Close quick view

    if (currentQuickView) {
      currentQuickView.style.display = 'none';
      currentQuickView = null;
    }




    // Set full popup content

    popupImg.src = currentProduct.images[0];
    popupImg.alt = currentProduct.title;
    title.textContent = currentProduct.title;

    const priceValue = (currentProduct.price / 100).toFixed(2);
    price.textContent = `${priceValue}€`;




    // Set description

    const tempDiv = document.createElement('div');
    tempDiv.innerHTML = currentProduct.description;
    const descText = tempDiv.textContent || tempDiv.innerText || '';
    desc.textContent = descText.substring(0, 130) + (descText.length > 130 ? '...' : '');

    // Build options - COLOR FIRST, then others
    optionsWrap.innerHTML = '';
    selectedOptions = {};


    if (currentProduct.options && currentProduct.options.length > 0) {
      // Separate color and other options
      const colorOption = currentProduct.options.find(opt => opt.name.toLowerCase() === 'color');
      const otherOptions = currentProduct.options.filter(opt => opt.name.toLowerCase() !== 'color');



      // Render COLOR first if it exists
      if (colorOption) {
        renderColorOption(colorOption);
      }



      // Then render other options (Size, etc.)
      otherOptions.forEach(opt => {
        // Skip default "Title" option
        if (opt.name === 'Title' && opt.values.length === 1 && opt.values[0] === 'Default Title') {
          return;
        }
        renderDropdownOption(opt);
      });
    }



    // Show full popup
    popup.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }



  // Render color option as buttons
  function renderColorOption(opt) {
    const group = document.createElement('div');
    group.className = 'option-group';

    const label = document.createElement('label');
    label.textContent = opt.name;
    group.appendChild(label);

    const colorWrapper = document.createElement('div');
    colorWrapper.className = 'color-options-wrapper';

    opt.values.forEach((v, idx) => {
      const colorBtn = document.createElement('button');
      colorBtn.className = 'color-option' + (idx === 0 ? ' active' : '');
      colorBtn.textContent = v;
      colorBtn.dataset.value = v;
      colorBtn.dataset.optionName = opt.name;
      colorBtn.type = 'button';

      colorBtn.addEventListener('click', () => {
        colorWrapper.querySelectorAll('.color-option').forEach(b => b.classList.remove('active'));
        colorBtn.classList.add('active');
        selectedOptions[opt.name] = v;
      });

      colorWrapper.appendChild(colorBtn);
    });

    group.appendChild(colorWrapper);
    optionsWrap.appendChild(group);
    selectedOptions[opt.name] = opt.values[0];
  }



  // Render other options as dropdowns
  function renderDropdownOption(opt) {
    const group = document.createElement('div');
    group.className = 'option-group';

    const label = document.createElement('label');
    label.textContent = opt.name;
    group.appendChild(label);

    const select = document.createElement('select');
    select.dataset.optionName = opt.name;

    opt.values.forEach(v => {
      const option = document.createElement('option');
      option.value = v;
      option.textContent = v;
      select.appendChild(option);
    });

    select.addEventListener('change', () => {
      selectedOptions[opt.name] = select.value;
    });

    group.appendChild(select);
    optionsWrap.appendChild(group);
    selectedOptions[opt.name] = opt.values[0];
  }



  // Close full popup
  const closePopup = () => {
    popup.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  };

  popup.querySelector('.product-popup__close').addEventListener('click', closePopup);
  popup.querySelector('.product-popup__overlay').addEventListener('click', closePopup);



  // Close on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (popup.getAttribute('aria-hidden') === 'false') {
        closePopup();
      } else if (currentQuickView) {
        currentQuickView.style.display = 'none';
        currentQuickView = null;
      }
    }
  });



  // Add to cart
  addBtn.addEventListener('click', async () => {
    if (!currentProduct) return;

    try {
      let variant;
      
      // If no options or only default title
      if (Object.keys(selectedOptions).length === 0) {
        variant = currentProduct.variants[0];
      } else {
        // Find matching variant
        const optionValues = Object.values(selectedOptions);
        variant = currentProduct.variants.find(v =>
          optionValues.every(val => v.options.includes(val))
        );
      }

      if (!variant) {
        alert('Please select all options');
        return;
      }



      // Disable button during processing
      addBtn.disabled = true;
      const originalText = addBtn.innerHTML;
      addBtn.innerHTML = 'ADDING...';



      // Add main product to cart
      await fetch('/cart/add.js', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ id: variant.id, quantity: 1 })
      });



      // Special rule: Add jacket if Black + Medium selected
      const optionValues = Object.values(selectedOptions);
      if (optionValues.includes('Black') && optionValues.includes('Medium')) {
        try {
          const jacketRes = await fetch('/products/soft-winter-jacket.js');
          const jacket = await jacketRes.json();

          await fetch('/cart/add.js', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({ id: jacket.variants[0].id, quantity: 1 })
          });
        } catch (error) {
          console.error('Error adding bonus jacket:', error);
        }
      }




      // Show success state
      addBtn.innerHTML = 'ADDED ✓';
      
      setTimeout(() => {
        closePopup();
        addBtn.disabled = false;
        addBtn.innerHTML = originalText;
      }, 800);
      


      // Optional: Trigger cart update
      if (window.theme && window.theme.cartUpdateCallbacks) {
        window.theme.cartUpdateCallbacks();
      }

    } catch (error) {
      console.error('Error adding to cart:', error);
      addBtn.disabled = false;
      addBtn.innerHTML = 'ADD TO CART <span class="arrow">→</span>';
      alert('There was an error adding to cart. Please try again.');
    }
  });

});
</script>






