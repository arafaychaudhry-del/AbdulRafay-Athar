    max-height: 80vh;
    overflow-y: auto;
  }


  .product-popup__top {
    padding: 12px;
    gap: 8px;
  }


  .product-popup__image-wrapper {
    width: 70px;
  }


  .product-popup__title {
    font-size: 13px;
    margin-bottom: 3px;
  }


  .product-popup__price {
    font-size: 13px;
    margin-bottom: 5px;
  }


  .product-popup__description {
    font-size: 10px;
    line-height: 1.4;
  }


  .product-popup__options {
    padding: 0 12px;
  }


  .option-group {
    margin-bottom: 8px;
  }


  .option-group label {
    font-size: 11px;
    margin-bottom: 4px;
  }


  .color-option {
